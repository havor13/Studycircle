generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum ResourceKind {
  FILE
  LINK
}

// NEW in step 8
enum NotificationKind {
  NEW_POST
  MEMBER_JOINED
  ROLE_CHANGED
  POST_REACTION
  NEW_EVENT // NEW in step 13
  EVENT_REMINDER // NEW in step 18
  CONTENT_REPORT // NEW in step 33
  NEW_COMMENT // NEW in step 37
  CALL_STARTED // NEW in step 40
}

enum ReportStatus {
  OPEN
  RESOLVED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  image        String?
  bio          String?
  createdAt    DateTime @default(now())
  emailNotifications Boolean @default(true) // NEW in step 15
  emailOff           NotificationKind[] @default([]) // NEW in step 41: kinds of email this person turned off
  emailDirectMessages Boolean @default(true) // NEW in step 41: email about private messages
  tokenVersion       Int     @default(0) // NEW in step 23: raising it logs the account out on every device

  memberships        Membership[]
  posts              Post[]
  messages           Message[]
  resources          Resource[]
  reactions          Reaction[]
  studySessions      StudySession[]
  notifications      Notification[] @relation("NotificationRecipient") // NEW in step 8
  actedNotifications Notification[] @relation("NotificationActor") // NEW in step 8
  createdEvents      StudyEvent[] // NEW in step 13
  eventRsvps         EventRsvp[] // NEW in step 13
  sentInvites        InviteEmail[] // NEW in step 17
  passwordResets     PasswordReset[] // NEW in step 20
  dmSent     DirectMessage[] @relation("DmSent")
  dmReceived DirectMessage[] @relation("DmReceived")
  blocking   UserBlock[] @relation("Blocker")
  blockedBy  UserBlock[] @relation("Blocked")
  directReactions DirectReaction[]
  reportsMade     ContentReport[] @relation("Reporter")
  reportsHandled  ContentReport[] @relation("Resolver")
  comments        Comment[]
}

model Group {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  subject     String?
  isPrivate   Boolean  @default(false)
  listed      Boolean  @default(false) // NEW in step 16: shown in Find circles. Off until an admin turns it on.
  inviteCode  String   @unique @default(cuid())
  createdAt   DateTime @default(now())

  // NEW in step 40: the last time someone announced a call in this circle (shown as a banner for two hours)
  callStartedAt     DateTime?
  callStartedByName String?

  memberships   Membership[]
  posts         Post[]
  messages      Message[]
  resources     Resource[]
  studySessions StudySession[]
  notifications Notification[] // NEW in step 8
  events        StudyEvent[] // NEW in step 13
  inviteEmails  InviteEmail[] // NEW in step 17
  reports       ContentReport[]
}

// Roles live here so pinned posts and moderation tools can be added later
// without a schema change.
model Membership {
  id       String   @id @default(cuid())
  userId   String
  groupId  String
  role     Role     @default(MEMBER)
  joinedAt DateTime @default(now())
  postsSeenAt DateTime @default(now()) // NEW in step 48: last time this person opened the circle page
  chatSeenAt  DateTime @default(now()) // NEW in step 48: last time this person opened the circle chat

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
}

model Post {
  id        String   @id @default(cuid())
  groupId   String
  authorId  String
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  editedAt  DateTime? // NEW in step 22: set only when the author edits the text

  group     Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions Reaction[]
  reports   ContentReport[]
  comments  Comment[]

  @@index([groupId, createdAt])
}

model Message {
  id        String   @id @default(cuid())
  groupId   String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  // Optional attached image or document (stored privately in Vercel Blob).
  attachmentPath String?
  attachmentName String?
  attachmentSize Int?

  group     Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions Reaction[]
  reports   ContentReport[]

  @@index([groupId, createdAt])
}

model Resource {
  id         String       @id @default(cuid())
  groupId    String
  uploaderId String
  title      String
  kind       ResourceKind
  url        String
  sizeBytes  Int?
  tags       String[]
  createdAt  DateTime     @default(now())

  group    Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  uploader User  @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
}

// One reaction table for both posts and chat messages.
model Reaction {
  id        String  @id @default(cuid())
  emoji     String
  userId    String
  postId    String?
  messageId String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, postId, emoji])
  @@unique([userId, messageId, emoji])
}

model StudySession {
  id        String   @id @default(cuid())
  userId    String
  groupId   String
  topic     String?
  minutes   Int
  startedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([groupId, startedAt])
}

// NEW in step 8: one row per person who should be told about something.
model Notification {
  id        String           @id @default(cuid())
  userId    String // who receives it
  actorId   String? // who caused it (kept as null if that account is deleted)
  groupId   String
  kind      NotificationKind
  message   String
  link      String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user  User  @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

// NEW in step 13: a planned group study session.
model StudyEvent {
  id              String   @id @default(cuid())
  groupId         String
  creatorId       String
  title           String
  startsAt        DateTime
  durationMinutes Int      @default(60)
  location        String? // a room, or a meeting link
  notes           String?
  createdAt       DateTime @default(now())
  reminderSentAt  DateTime? // NEW in step 18: set once the reminder went out

  group   Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator User        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  rsvps   EventRsvp[]

  @@index([groupId, startsAt])
}

// One row per person who says "I'm going".
model EventRsvp {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event StudyEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

// NEW in step 17: one row per invitation email that was actually sent.
// Used for the daily limit and to avoid inviting the same address twice in a week.
model InviteEmail {
  id          String   @id @default(cuid())
  groupId     String
  invitedById String
  email       String
  createdAt   DateTime @default(now())

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitedBy User  @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@index([invitedById, createdAt])
}

// NEW in step 20: one row per "forgot password" link. Only a hash of the link's secret is stored,
// so a leaked database cannot be used to reset anyone's password.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// NEW in step 21: one row per FAILED login, used to slow down password guessing.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// Private one-to-one messages between two people who share a circle.
model DirectMessage {
  id          String    @id @default(cuid())
  senderId    String
  recipientId String
  body        String
  createdAt   DateTime  @default(now())
  readAt      DateTime?

  // Optional attached image or document (stored privately in Vercel Blob).
  attachmentPath String?
  attachmentName String?
  attachmentSize Int?
  reactions      DirectReaction[]

  sender    User @relation("DmSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("DmReceived", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
}

// "Blocker blocked Blocked": neither of them can send private messages to the other.
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model DirectReaction {
  id        String @id @default(cuid())
  emoji     String
  userId    String
  messageId String

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  message DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId, emoji])
  @@index([messageId])
}

// A member flags a post or a circle chat message for the circle's moderators.
model ContentReport {
  id           String       @id @default(cuid())
  groupId      String
  reporterId   String
  postId       String?
  messageId    String?
  commentId    String? // NEW in step 38
  reason       String
  status       ReportStatus @default(OPEN)
  createdAt    DateTime     @default(now())
  resolvedById String?
  resolvedAt   DateTime?

  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  reporter   User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User?    @relation("Resolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  post       Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  message    Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  comment    Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([reporterId, postId])
  @@unique([reporterId, messageId])
  @@unique([reporterId, commentId])
  @@index([groupId, status, createdAt])
}

// A reply under a post.
model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  editedAt  DateTime? // NEW in step 38: set when the author edits the text

  post    Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reports ContentReport[]

  @@index([postId, createdAt])
}
